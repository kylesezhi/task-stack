# Compose auto-loads `.env` from the directory holding docker-compose.yml —
# `cp .env.example .env` first. Every default below matches the compose file;
# change only what you need.

# Host port the app is reachable on. Change it if 8181 is already taken on
# the machine (symptom: "port is already allocated" at `up`, DEPLOY.md §9).
HOST_PORT=8181

# Address the host port binds to. 0.0.0.0 = reachable from the LAN — fine
# only because this app is single-user with no auth and is meant to stay
# LAN-only (DECISIONS.md §9). Set 127.0.0.1 to lock it to this machine.
BIND_ADDR=0.0.0.0

# Image tag compose builds/uses. Leave at latest for the normal flow;
# DEPLOY.md's update step retags the RUNNING container's image as `rollback`,
# and `IMAGE_TAG=rollback docker compose up -d` brings it back.
IMAGE_TAG=latest
